{
  "name": "schoolsafe-control-app",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node -e \"require('node:fs').cpSync('public','dist/public',{recursive:true}); require('node:fs').cpSync('src/db/schema.sql','dist/src/db/schema.sql'); require('node:fs').cpSync('src/db/schema.sqlite.sql','dist/src/db/schema.sqlite.sql');\"",
    "start": "node dist/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "5.12.0",
    "pg": "^8.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.15.30",
    "@types/pg": "^8.21.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
