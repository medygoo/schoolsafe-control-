[Unit]
Description=SchoolSafe Control Trial Expiration Check
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -s -X POST ${CONTROL_API_URL:-http://localhost:3000}/instances/check-expired-trials -H "x-admin-token: ${ADMIN_TOKEN}"
EnvironmentFile=/etc/schoolsafe-control/env
User=schoolsafe
Group=schoolsafe