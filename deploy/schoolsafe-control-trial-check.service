[Unit]
Description=SchoolSafe Control Trial Expiration Check
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -s -X POST http://localhost:3000/instances/check-expired-trials -H "Authorization: Bearer ${ADMIN_TOKEN}"
EnvironmentFile=/etc/schoolsafe-control/env
User=schoolsafe
Group=schoolsafe